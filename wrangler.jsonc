{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "three-calendar",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "CALENDAR_KV"
    }
  ]
}
